(imp 0 S9 1000)
(stim S9 4)
(imp 0 W1 1000)
(stim W1 4)
(imp 0 W4 1000)
(stim W4 1)

; ---------- epoch 0 -> 1 ----------
!(let $rs (collapse (match &self (imp 0 $c $v) (/ (* $v 50) 1000))) (add-atom &self (total-rent 0 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (stim $c $s) $s)) (add-atom &self (total-stim 0 (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp 0 $c $v) (stim $c $s) (total-rent 0 $tr) (total-stim 0 $ts)) (imp 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))

; ---------- epoch 1 -> 2 ----------
!(let $rs (collapse (match &self (imp 1 $c $v) (/ (* $v 50) 1000))) (add-atom &self (total-rent 1 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (stim $c $s) $s)) (add-atom &self (total-stim 1 (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp 1 $c $v) (stim $c $s) (total-rent 1 $tr) (total-stim 1 $ts)) (imp 2 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))

; ---------- epoch 2 -> 3 ----------
!(let $rs (collapse (match &self (imp 2 $c $v) (/ (* $v 50) 1000))) (add-atom &self (total-rent 2 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (stim $c $s) $s)) (add-atom &self (total-stim 2 (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp 2 $c $v) (stim $c $s) (total-rent 2 $tr) (total-stim 2 $ts)) (imp 3 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))

; ---------- CONTROL: conservation ----------
; rent is redistributed as wages, so the total must stay within
; floor-division loss of 60000. A total that is a
; MULTIPLE of it means an unindexed atom multiplied the join —
; which is exactly what an un-epoch-indexed (total-stim) did.
!(let $vs (collapse (match &self (imp 3 $c $v) $v)) (< (foldl-atom $vs 0 $a $b (+ $a $b)) 63000))

; ---------- result ----------
!(collapse (match &self (imp 3 $c $v) ($c $v)))
!(let $vs (collapse (match &self (imp 3 $c $v) $v)) (foldl-atom $vs 0 $a $b (+ $a $b)))
