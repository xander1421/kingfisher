; G5 — deterministic fixed-point ECAN over the G1 citation graph
; SCALE=1000 RENT_RATE=50 SEED=1000 EPOCHS=3
(imp 0 B1 1000)
(stim B1 2)
(imp 0 M1 1000)
(stim M1 8)
(imp 0 N1 1000)
(stim N1 2)
(imp 0 Q1 1000)
(stim Q1 3)
(imp 0 S1 1000)
(stim S1 2)
