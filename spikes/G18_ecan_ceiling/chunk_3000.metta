!(let $rs (collapse (match &self (, (imp 0 $c $v) (bucket $c b0)) (/ (* $v 50) 1000))) (add-atom &self (subtotal b0 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $rs (collapse (match &self (, (imp 0 $c $v) (bucket $c b1)) (/ (* $v 50) 1000))) (add-atom &self (subtotal b1 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $rs (collapse (match &self (, (imp 0 $c $v) (bucket $c b2)) (/ (* $v 50) 1000))) (add-atom &self (subtotal b2 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $rs (collapse (match &self (, (imp 0 $c $v) (bucket $c b3)) (/ (* $v 50) 1000))) (add-atom &self (subtotal b3 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $rs (collapse (match &self (, (imp 0 $c $v) (bucket $c b4)) (/ (* $v 50) 1000))) (add-atom &self (subtotal b4 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $rs (collapse (match &self (, (imp 0 $c $v) (bucket $c b5)) (/ (* $v 50) 1000))) (add-atom &self (subtotal b5 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (subtotal $b $s) $s)) (add-atom &self (total-rent (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(match &self (total-rent $t) (RENT $t))
