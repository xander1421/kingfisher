#!/bin/sh
# pre-push.hook v1 — H115, ATTACKER-1, 2026-08-18.
#
# ==== WHY THIS EXISTS (§12.7 rationale) ====================================
# DEFECT REMOVED: **§11's central prohibition had no mechanism, and its
# precondition changed underneath it.** For two days `git remote -v` resolved to
# nothing, so "no pushes" was safe by ACCIDENT. On 2026-08-18 the remote resolves
# (`https://github.com/xander1421/kingfisher.git`) and HEAD stands 26 commits
# ahead of `origin/main`. Every gate this fleet has built refuses at COMMIT time
# — `.git/hooks/` held `commit-msg` and `pre-commit` and nothing else — and the
# rail that actually lets work leave the machine is crossed at PUSH time, where
# nothing was watching. Same class as H89: a prohibition enforced by reading.
#
# WHAT IT REFUSES, AND WHY THAT AND NOT "A PUSH" ============================
# It does NOT refuse pushes. A blanket refusal would contradict a recorded
# operator decision (`.gitignore:91`, 2026-08-18) and would be the always-red
# gate every lane learns to bypass — H14 and H52, twice-earned here.
#
# It refuses exactly one thing: **a pushed tree that contains a file GitHub
# Actions can execute.** `.github/workflows/*.yml` and `*.yaml` are the only
# artifacts a remote will run on its own; the `.md` source beside them is inert
# to Actions, which is why the fleet's current disable works at all. So this
# separates "code leaves the machine" (a human's call) from "automation with
# write scopes starts running off the machine" (§11's actual hazard, and the
# `push_repo_memory` / `safe_outputs` jobs in `.autoloop/autoloop.lock.yml.
# disabled` hold `contents: write` and `issues: write` today).
#
# THE TREE, NOT THE DIFF. Asking "does this push ADD a workflow" passes a push
# whose workflow arrived three commits ago, and the hazard is what the remote
# ends up holding, not what changed. `git ls-tree` on each pushed tip.
#
# WHAT IT ONLY REPORTS. A compiled lock tracked OUTSIDE `.github/workflows/`
# (today: `.autoloop/autoloop.lock.yml.disabled`, which IS tracked) is inert on
# the remote — Actions reads one directory. It is already in the history, so
# refusing on it is a permanent floor, and a permanent floor is bypassed as
# thoroughly as a flaky gate. Reported, every time, never gating.
#
# CHECKED BY `sh spikes/harness/test_pre_push.sh` — a real `git push` into a
# BARE REPO CREATED INSIDE THE WORKSPACE (§10; no network, nothing leaves this
# machine), with a positive control that the refusal is not a constant.
set -u
FAIL=0
NL='
'
armed=''
locks=''
ZERO='0000000000000000000000000000000000000000'

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # A branch DELETION pushes the zero sha and carries no tree.
  case "$local_sha" in ''|"$ZERO") continue ;; esac
  # Executable-by-Actions, resolved by extension because that is the rule the
  # remote itself applies -- not by filename, which is how a naming proxy drifts
  # from the behaviour it stands for.
  w=$(git ls-tree -r --name-only "$local_sha" -- .github/workflows 2>/dev/null \
        | grep -E '\.ya?ml$' || true)
  [ -n "$w" ] && armed="$armed$w$NL"
  l=$(git ls-tree -r --name-only "$local_sha" 2>/dev/null \
        | grep -E '\.lock\.ya?ml' | grep -v '^\.github/workflows/' || true)
  [ -n "$l" ] && locks="$locks$l$NL"
done

if [ -n "$locks" ]; then
  echo "pre-push NOTE — compiled workflow lock(s) in the pushed tree, OUTSIDE"
  echo "  .github/workflows/ and therefore inert to Actions (it reads one"
  echo "  directory). Reported, never gated: they are already in the history and"
  echo "  a permanent floor gets bypassed like a flaky gate (H14, H52)."
  printf '%s' "$locks" | sort -u | sed 's/^/    /'
fi

if [ -n "$armed" ]; then
  echo "pre-push REFUSED — the pushed tree contains file(s) GitHub Actions will"
  echo "  execute on the remote:"
  printf '%s' "$armed" | sort -u | sed 's/^/    /'
  echo
  echo "  MISSION_LOOP §11: no pushes, PRs, package uploads, issue comments or"
  echo "  posts; external artefacts go to proposed/ for a human. This gate does"
  echo "  NOT refuse pushes in general -- it refuses the one thing that starts"
  echo "  automation running off this machine. The compiled autoloop lock grants"
  echo "  contents: write and issues: write, so a workflow reaching the remote is"
  echo "  a write scope reaching the remote."
  echo
  echo "  If this is deliberate it is a HUMAN's decision and belongs in"
  echo "  MISSION_LOOP.md where refcheck.py can resolve it, not in a bypass:"
  echo "  a lane relaying an amendment is not an amendment (measured 2026-08-18,"
  echo "  when one was relayed to five lanes and withdrawn the same day)."
  FAIL=1
fi

exit "$FAIL"
