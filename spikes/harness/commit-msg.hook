#!/bin/sh
# GATE for MISSION_LOOP §13.1. Validates VALUES, not just presence.
#
# v1 checked only that the trailer keys existed. The history shows what that
# bought: 11 of 26 `Atom:` values were topic labels ("mutation-detection"),
# AGENT-1/agent-1 split one atom into two, and `Reviewed-By: self` walked past
# the A22 self-review guard ELEVEN times because "self" != "AGENT-1". A guard
# against self-review, defeated by typing the word self. Exactly one genuine
# peer attestation existed in the whole history.
#
# `man githooks`: commit-msg "takes a single parameter, the name of the file
# that holds the proposed commit log message". pre-commit takes none — v1 was
# installed there and refused every commit, failing closed.
#
# Bypass: git commit --no-verify. Deliberate: this hook is shared by every lane
# in this working tree.

msg=$(cat "$1")
val() { echo "$msg" | sed -n "s/^$1:[[:space:]]*//p" | head -1 | tr -d '\r'; }
up()  { echo "$1" | tr 'a-z' 'A-Z'; }

missing=""
for t in "Atom" "Claude-Session" "Reviewed-By"; do
  echo "$msg" | grep -q "^$t:" || missing="$missing $t"
done
if [ -n "$missing" ]; then
  echo "commit-msg REFUSED — missing trailer(s):$missing"
  echo "  Atom: <CALLSIGN>   Claude-Session: <url>   Reviewed-By: <CALLSIGN|unreviewed>"
  echo "Bypass: git commit --no-verify"
  exit 1
fi

atom=$(up "$(val Atom)")
rev=$(up "$(val Reviewed-By)")

# A callsign is upper-case, hyphenated, and contains a digit.
is_callsign() {
  echo "$1" | grep -Eq '^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$' && echo "$1" | grep -q '[0-9]'
}

if ! is_callsign "$atom"; then
  echo "commit-msg REFUSED — Atom '$atom' is not a callsign."
  echo "That field names WHO made the commit, not what it was about."
  echo "Expected e.g. AGENT-2, ATOM-3, ATTACKER-1. Subject line carries the topic."
  exit 1
fi

case "$rev" in
  UNREVIEWED) exit 0 ;;
  SELF|ME|NONE|N/A|NA|UNKNOWN|NOBODY|MYSELF|OWN|-|"")
    echo "commit-msg REFUSED — Reviewed-By '$rev' is self-review in plain language."
    echo "A22: the reviewed party supplied the review. Name another atom, or"
    echo "write 'unreviewed', which is legal and gets recorded as unreviewed."
    exit 1 ;;
esac

if ! is_callsign "$rev"; then
  echo "commit-msg REFUSED — Reviewed-By '$rev' is neither a callsign nor 'unreviewed'."
  exit 1
fi
if [ "$rev" = "$atom" ]; then
  echo "commit-msg REFUSED — self-review: Atom '$atom' reviewed by '$rev'."
  exit 1
fi
exit 0
