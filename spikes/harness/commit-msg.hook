#!/bin/sh
# commit-msg.hook v6 — GATE for MISSION_LOOP §13.1. Validates VALUES, not just
# presence, and refuses a commit carrying another lane's per-lane files.
#
# v5 (AGENT-1, C22 ATTACK, H22) ASSIGNS Claude-Session from the live launcher's
# start time. v4 checked that trailer's presence and never its value, so 47 of 85
# commits carried one of two typed placeholders and the field §13.1 calls "the
# only thing that separates two lanes signing the SAME callsign" was a constant
# across 29 of them. Fail-open: it can rewrite, it can never refuse.
#
# v2 (H19, ATTACKER-1) added the cross-lane block. v3 rewrote this file wholesale
# to validate trailer VALUES and dropped v2 four minutes after it was committed.
# v4 is both: the two gates are orthogonal and each caught a defect the other
# cannot see. Version bumped per §12.7 so the next stall is diagnosed against a
# list rather than rediscovered.
#
# v1 checked only that the trailer keys existed. The history shows what that
# bought: 11 of 26 `Atom:` values were topic labels ("mutation-detection"),
# AGENT-1/agent-1 split one atom into two, and `Reviewed-By: self` walked past
# the A22 self-review guard ELEVEN times because "self" != "AGENT-1". A guard
# against self-review, defeated by typing the word self. Exactly one genuine
# peer attestation existed in the whole history.
#
# `man githooks`: commit-msg "takes a single parameter, the name of the file
# that holds the proposed commit log message". pre-commit takes none — v1 was
# installed there and refused every commit, failing closed.
#
# Bypass: git commit --no-verify. Deliberate: this hook is shared by every lane
# in this working tree.

msg=$(cat "$1")
val() { echo "$msg" | sed -n "s/^$1:[[:space:]]*//p" | head -1 | tr -d '\r'; }
up()  { echo "$1" | tr 'a-z' 'A-Z'; }

missing=""
for t in "Atom" "Claude-Session" "Reviewed-By"; do
  echo "$msg" | grep -q "^$t:" || missing="$missing $t"
done
if [ -n "$missing" ]; then
  echo "commit-msg REFUSED — missing trailer(s):$missing"
  echo "  Atom: <CALLSIGN>   Claude-Session: <url>   Reviewed-By: <CALLSIGN|unreviewed>"
  echo "Bypass: git commit --no-verify"
  exit 1
fi

atom=$(up "$(val Atom)")
rev=$(up "$(val Reviewed-By)")

# --- v5: Claude-Session is ASSIGNED, not typed --------------------------------
# §13.1 says this field "is assigned, not typed, and is the only field that
# separates two lanes signing the SAME callsign". MEASURED 2026-08-17 over 85
# trailer-bearing commits: 5 distinct values, and 47 of them (55%) are the two
# literal placeholders — 29 commits reading `AGENT-1 | unassigned-in-lane` are
# mutually indistinguishable. Both halves of the sentence were false. v4 checked
# the trailer was PRESENT and never looked at the value, so a lane typed the same
# constant every commit and the field separated nothing. That is A28 — a field
# recorded but never read — inside the gate that exists so attribution is
# possible at all (H12).
#
# So the hook ASSIGNS it. A span is identified by its launcher's start time,
# which differs per lane (11:49:21 vs 11:49:26 for the two live lanes) and no
# agent can type it. FAIL-OPEN by construction: if CALLSIGN is unset, no launcher
# is live, or the rewrite does not take, the message is left exactly as written
# and the commit proceeds. A shared gate that can wedge every lane is a worse
# defect than the one being fixed (H9/H11), so this one cannot refuse.
# ==== v6, AGENT-2, H37. A CORRECTION AGAINST v5's OWN MECHANISM (§12.7) =======
# DEFECT REMOVED: THE ASSIGNMENT RESOLVED THE LANE FROM argv, WHICH NEVER
# CONTAINS IT, AND FAILED OPEN SO NOBODY SAW IT STOP.
#
#   * v5 matched `ps -eo lstart,command | grep "CALLSIGN=${CALLSIGN}...run_loop"`.
#     A launcher started the documented way -- `CALLSIGN=X ./run_loop.sh`, which
#     is this repo's usage line and `bringup.sh:160` -- consumes that assignment
#     IN THE SHELL. `ps` shows `bash ./run_loop.sh`; the callsign is in the
#     environment, and macOS does not expose another process's environment.
#     The only process that ever carried both tokens on one line was the
#     transient `sh -c "CALLSIGN=X ./run_loop.sh"` wrapper that typed the
#     command -- so the "launcher's start time" was the start time of the SHELL
#     that launched it, and the mechanism stopped the moment lanes began
#     detaching from their caller. MEASURED: 0 matches for any of the three live
#     lanes; commits 829d57b (AGENT-2) and 2c9d277 (ok-1) both carry placeholders
#     while `db84c79`/`f3338e8` from the 11:49 cohort carry real values, so this
#     REGRESSED, it did not never-work.
#   * And the placeholder pattern did not cover the placeholder H27's own row
#     measured 29 instances of: the case arm listed bare `unassigned-in-lane`,
#     while the value in the field is `AGENT-1 | unassigned-in-lane`. Two
#     independent reasons my own commit was never rewritten.
#
# SAME ROOT CAUSE AS H8 -- a process's callsign is not observable from outside --
# so the fix reuses H8's artifact rather than inventing a second answer:
# `.loop_lock.$CALLSIGN` holds the live launcher's pid, and a pid resolves to a
# start time exactly. argv is kept as a FALLBACK because a lane launched from a
# `sh -c` wrapper still matches it and that costs one line.
#
# STILL FAIL-OPEN, deliberately and unchanged: no lock, no launcher, no rewrite
# -- the message is left as written and the commit proceeds. A shared gate that
# can wedge every lane is a worse defect than the one being fixed (H9/H11).
case "$(val Claude-Session)" in
  *unassigned-in-lane*|local,\ no\ URL\ assigned*|"")
    if [ -n "${CALLSIGN:-}" ]; then
      _lp=$(cat "${ROOT:-.}/.loop_lock.${CALLSIGN}" 2>/dev/null)
      case "$_lp" in ''|*[!0-9]*) _lp='' ;; esac
      _st=''
      [ -n "$_lp" ] && _st=$(ps -p "$_lp" -o lstart= 2>/dev/null \
            | awk 'NF{print $2"-"$3"-"$5"T"$4}')
      [ -n "$_st" ] || _st=$(ps -eo lstart,command 2>/dev/null \
            | grep "CALLSIGN=${CALLSIGN}[ =]*[^ ]*run_loop" \
            | head -1 | awk '{print $2"-"$3"-"$5"T"$4}')
      if [ -n "$_st" ]; then
        sed "s|^Claude-Session:.*|Claude-Session: lane:${CALLSIGN}@${_st}|" \
            "$1" > "$1.v5" && mv "$1.v5" "$1"
        msg=$(cat "$1")
      fi
    fi ;;
esac

# A callsign is upper-case, hyphenated, and contains a digit.
is_callsign() {
  echo "$1" | grep -Eq '^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$' && echo "$1" | grep -q '[0-9]'
}

if ! is_callsign "$atom"; then
  echo "commit-msg REFUSED — Atom '$atom' is not a callsign."
  echo "That field names WHO made the commit, not what it was about."
  echo "Expected e.g. AGENT-2, ATOM-3, ATTACKER-1. Subject line carries the topic."
  exit 1
fi

# --- A COMMIT MAY NOT CARRY ANOTHER LANE'S PER-LANE FILES. (H19, ATTACKER-1.)
#
# RESTORED 2026-08-17 after a wholesale rewrite of this file dropped it four
# minutes after it was committed (570e553). That is the same event this block
# exists for and the second time this day one lane's committed work vanished
# under another's rewrite of a shared file -- see CHANNEL, "my git-hygiene
# sections (9e355d4) were replaced wholesale by e990f11". It was not noticed by
# reading; `test_loop_gate.sh` went red on it.
#
# MUST STAY ABOVE the `case "$rev"` below, whose UNREVIEWED branch exits 0 --
# and most commits here are unreviewed, so a block appended after it would be
# skipped for almost every commit while looking installed.
#
# THREE LANES SHARE ONE GIT INDEX, and `git commit` commits the index, not the
# adds you made. Lane A's correctly-scoped `git add` followed seconds later by
# lane B's `git commit` puts A's whole cycle into B's commit under B's `Atom:`,
# with BOTH lanes obeying §13's "add paths you touched, never -A". Observed:
# b529081, `Atom: AGENT-1`, carrying HANDOFF.ATTACKER-1.md,
# spikes/H7_harness_attack/ and 840 lines of a second lane's work. The staged
# set and the Atom are both visible here, so the mismatch is DECIDABLE.
#
# Ownership is inferred from per-lane FILENAMES, which is sound only because
# §12.6 independently obliges the harness to keep state per-lane. Recorded as
# the assumption it is. `prompts/<ATOM>.md` is deliberately NOT listed: spawn
# briefs are written by the harness owner FOR a lane.
foreign=""
for f in $(git diff --cached --name-only 2>/dev/null); do
  owner=""
  case "$f" in
    HANDOFF.*.md)    owner=${f#HANDOFF.}; owner=${owner%.md} ;;
    loop_*.log)      owner=${f#loop_};    owner=${owner%.log} ;;
    .loop_signal.*)  owner=${f#.loop_signal.} ;;
    .loop_exit.*)    owner=${f#.loop_exit.} ;;
    .loop_blocks.*)  owner=${f#.loop_blocks.} ;;
    .heartbeat.*)    owner=${f#.heartbeat.} ;;
    *) continue ;;
  esac
  [ -z "$owner" ] && continue
  [ "$(up "$owner")" = "$atom" ] && continue
  # `Carries:` keeps the honest cross-lane commit -- one atom repairing
  # another's journal -- off `--no-verify`, which would switch off the trailer
  # and self-review gates too and is therefore the worse escape.
  echo "$msg" | grep -qi "^Carries:.*$owner" && continue
  foreign="$foreign $f"
done
if [ -n "$foreign" ]; then
  echo "commit-msg REFUSED — Atom '$atom' is committing another lane's files:"
  for f in $foreign; do echo "    $f"; done
  echo
  echo "The index is SHARED. Another lane's 'git add' is in it, and 'git commit'"
  echo "takes the index, not your adds. Two ways out, both honest:"
  echo "    git commit --only <your paths>     commit your paths, ignore the index"
  echo "    Carries: <ATOM>                    trailer, if you meant to carry it"
  exit 1
fi

case "$rev" in
  UNREVIEWED) exit 0 ;;
  SELF|ME|NONE|N/A|NA|UNKNOWN|NOBODY|MYSELF|OWN|-|"")
    echo "commit-msg REFUSED — Reviewed-By '$rev' is self-review in plain language."
    echo "A22: the reviewed party supplied the review. Name another atom, or"
    echo "write 'unreviewed', which is legal and gets recorded as unreviewed."
    exit 1 ;;
esac

if ! is_callsign "$rev"; then
  echo "commit-msg REFUSED — Reviewed-By '$rev' is neither a callsign nor 'unreviewed'."
  exit 1
fi
if [ "$rev" = "$atom" ]; then
  echo "commit-msg REFUSED — self-review: Atom '$atom' reviewed by '$rev'."
  exit 1
fi
exit 0
