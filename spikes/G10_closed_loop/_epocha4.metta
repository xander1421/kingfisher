!(let $ss (collapse (match &self (stim q_green $c $s) $s)) (add-atom &self (total-stim q_green (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp q_green 0 $c $v) (stim q_green $c $s) (total-rent q_green $tr) (total-stim q_green $ts)) (imp q_green 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
