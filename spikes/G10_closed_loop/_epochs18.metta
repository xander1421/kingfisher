!(collapse (match &self (imp q_red 1 $c $v) (IMPOF q_red $c $v)))
!(collapse (match &self (imp q_invalid 1 $c $v) (IMPOF q_invalid $c $v)))
!(collapse (match &self (imp q_green 1 $c $v) (IMPOF q_green $c $v)))
