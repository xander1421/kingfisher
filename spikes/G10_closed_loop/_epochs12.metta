!(let $rs (collapse (match &self (imp q_red 0 $c $v) (/ (* $v 50) 1000))) (add-atom &self (total-rent q_red (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (stim q_red $c $s) $s)) (add-atom &self (total-stim q_red (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp q_red 0 $c $v) (stim q_red $c $s) (total-rent q_red $tr) (total-stim q_red $ts)) (imp q_red 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
!(let $rs (collapse (match &self (imp q_invalid 0 $c $v) (/ (* $v 50) 1000))) (add-atom &self (total-rent q_invalid (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (stim q_invalid $c $s) $s)) (add-atom &self (total-stim q_invalid (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp q_invalid 0 $c $v) (stim q_invalid $c $s) (total-rent q_invalid $tr) (total-stim q_invalid $ts)) (imp q_invalid 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
