!(let $new (collapse (match &self (, (imp q_invalid 0 $c $v) (stim q_invalid $c $s) (total-rent q_invalid $tr) (total-stim q_invalid $ts)) (imp q_invalid 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
