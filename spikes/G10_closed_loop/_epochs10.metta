!(let $ss (collapse (match &self (stim q_2hop_red $c $s) $s)) (add-atom &self (total-stim q_2hop_red (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp q_2hop_red 0 $c $v) (stim q_2hop_red $c $s) (total-rent q_2hop_red $tr) (total-stim q_2hop_red $ts)) (imp q_2hop_red 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
!(let $rs (collapse (match &self (imp q_yellow 0 $c $v) (/ (* $v 50) 1000))) (add-atom &self (total-rent q_yellow (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (stim q_yellow $c $s) $s)) (add-atom &self (total-stim q_yellow (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp q_yellow 0 $c $v) (stim q_yellow $c $s) (total-rent q_yellow $tr) (total-stim q_yellow $ts)) (imp q_yellow 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
!(collapse (match &self (imp q_red 1 $c $v) (IMPOF q_red $c $v)))
!(collapse (match &self (imp q_invalid 1 $c $v) (IMPOF q_invalid $c $v)))
!(collapse (match &self (imp q_green 1 $c $v) (IMPOF q_green $c $v)))
!(collapse (match &self (imp q_2hop_red 1 $c $v) (IMPOF q_2hop_red $c $v)))
!(collapse (match &self (imp q_yellow 1 $c $v) (IMPOF q_yellow $c $v)))
