!(collapse (match &self (, (cites $x $y) (verdict $y RED)) (q_red $x $y)))
!(collapse (match &self (, (cites $x $y) (verdict $y INVALID)) (q_invalid $x $y)))
!(collapse (match &self (, (cites $x $y) (verdict $y GREEN)) (q_green $x $y)))
!(collapse (match &self (, (cites $x $z) (cites $z $y) (verdict $y RED)) (q_2hop_red $x $y)))
!(collapse (match &self (, (cites $x $y) (verdict $y YELLOW)) (q_yellow $x $y)))
