!(let $rs (collapse (match &self (imp 0 $c $v) (/ (* $v 50) 1000))) (add-atom &self (total-rent (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (stim $c $s) $s)) (add-atom &self (total-stim (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (imp 0 $c $v) (stim $c $s) (total-rent $tr) (total-stim $ts)) (imp 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
