!(let $rs (collapse (match &self (, (bucket b0 $c) (imp 0 $c $v)) (/ (* $v 50) 1000))) (add-atom &self (sub-rent b0 (foldl-atom $rs 0 $a $b (+ $a $b)))))
!(let $ss (collapse (match &self (, (bucket b0 $c) (stim $c $s)) $s)) (add-atom &self (sub-stim b0 (foldl-atom $ss 0 $a $b (+ $a $b)))))
!(let $r (collapse (match &self (sub-rent $b $s) $s)) (add-atom &self (total-rent (foldl-atom $r 0 $a $b (+ $a $b)))))
!(let $s (collapse (match &self (sub-stim $b $s) $s)) (add-atom &self (total-stim (foldl-atom $s 0 $a $b (+ $a $b)))))
!(let $new (collapse (match &self (, (bucket b0 $c) (imp 0 $c $v) (stim $c $s) (total-rent $tr) (total-stim $ts)) (imp 1 $c (+ (- $v (/ (* $v 50) 1000)) (/ (* $s $tr) $ts))))) (add-atoms &self $new))
!(collapse (match &self (, (bucket b0 $c) (imp 1 $c $v)) (IMP $c $v)))
