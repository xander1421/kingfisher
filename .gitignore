# foreign clones — read-only, re-cloneable, and not ours to redistribute
elders/

# third-party papers: local reading copies, not for redistribution
papers/*.pdf

# build artefacts
**/target/
**/.venv/
__pycache__/
*.pyc
*_pb2.py

# large generated space dumps from the cross-arch differential
spikes/S10_mork_android/crossrun/

# S14 cloned MORK's `server` branch for comparison — a foreign repo, like elders/
spikes/S14_mork_server/mork-server/

# cross-arch space dumps (48 MB+) — regenerate with crossrun.py
spikes/S16_mork_android/crossrun/
spikes/M1_1_android/app/build/
spikes/M1_1_android/.gradle/

# --- git hygiene (CLAUDE.md §2.2, enforced by spikes/harness/githygiene.py) ---
# The history is training data. 86% of history bytes were files >1MB while
# every result in this workspace is plain text. Commit the thing that MAKES
# the artefact -- source, Cargo.toml AND Cargo.lock, the command, the hash --
# not the artefact. A digest pins which artefact; a manifest pins the feature
# set behind it, and a Cargo feature changes fuel_used (V1_feature_fuel).

# third-party model weights: size, and a §7 licence question
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# compiled output — rebuild from source + pinned manifest
*.so
*.dylib
*.dll
*.a
*.apk
*.aar
*.jar
spikes/*/bin/fuelrun.*
**/jniLibs/

# archives
*.zip
*.tar
*.tar.gz
*.tgz

# regenerable run artefacts (the script that makes them IS committed)
spikes/G21_null_rust/split.txt
spikes/G21_null_rust/nulls.txt
**/.cxx/

# W4 rebuilds rk_inst to recover the per-shape table; the source and the run
# recipe are committed, the 50 KB binary is not (CLAUDE.md §2.2)
spikes/W4_prefilter_readset/rk_inst
spikes/W4_prefilter_readset/triples.bin

# MCP config may carry API keys — never commit
.mcp.json
**/.mcp.json

# S75 builds a probe against elders/PathMap; source and rustc version are
# committed, the 1 MB binary and the exported key dumps are not
spikes/S75_pathmap_check/pmprobe/target/
spikes/S75_pathmap_check/keys_*.bin
spikes/S77_proof_bytes/pmproof/target/
spikes/S82_kernel_truth/check
bringup.log

# per-lane launcher lock (run_loop.sh v6, H8): runtime state, one pid per
# callsign. Same category as .heartbeat.* and detach_*.log — regenerated at
# every launch and meaningless in another clone.
.loop_lock.*

# per-lane consecutive-failure count (run_loop.sh v9, H56): same category. The
# 86-minute fleet outage it exists to expose was only reconstructable because
# loop_*.log is TRACKED while bringup.log — the monitor that printed `quorum:
# 5/5` through all of it — is ignored above, so its evidence lives as a snapshot
# under spikes/H56_fleet_stall/evidence/ instead.
.loop_fails.*

# autoloop runs LOCALLY, operator's decision 2026-08-18: the technology does not
# leave this machine. The compiled lock is the only artifact GitHub can execute,
# so it is kept out of .github/workflows/ and out of the index. Recompiling with
# `gh aw compile` regenerates it there -- move it back out, or Actions becomes
# reachable again on the next dispatch.
.github/workflows/*.lock.yml
